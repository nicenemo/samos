---
services:
  traefik:
    image: traefik:v3.1
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /opt/compose/traefik/config/traefik.yaml:/etc/traefik/traefik.yaml:ro
      - /opt/compose/traefik/dynamic:/etc/traefik/dynamic:ro
      - /etc/ssl/local_certs:/etc/ssl/local_certs:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - internal-net

networks:
  internal-net:
    external: true
