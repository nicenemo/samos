---
services:
  opencode:
    image: ghcr.io/anomalyco/opencode:latest
    container_name: opencode
    restart: unless-stopped
    command: ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
    ports:
      - "4096:4096"
    volumes:
      - ./data:/home/opencode/.local/share/opencode
      - ./config:/home/opencode/.config/opencode
    labels:
      - "traefik.enable=true"
      - "traefik.http.services.opencode.loadbalancer.server.port=4096"
      - "traefik.http.routers.opencode.rule=Host(`opencode.{{ base_domain }}`)"
      - "traefik.http.routers.opencode.entrypoints=websecure"
      - "traefik.http.routers.opencode.tls=true"
    networks:
      - internal-net

networks:
  internal-net:
    external: true
